# Source des données : demo (défaut) | postgres (à partir du Sprint 3)
SIGNE_DATA_SOURCE=demo

# URL publique du site (métadonnées, liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domaine des médias (CDN / Supabase Storage), sans protocole
# NEXT_PUBLIC_MEDIA_HOST=xxxx.supabase.co

# Sprint 2+ : Supabase. La clé de service ne doit JAMAIS être préfixée NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Sprint 5 : paiement
# PAYMENT_PROVIDER=simulated
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
